{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:veto:dynamic-result:1.0.0",
  "type":"object", "additionalProperties":false,
  "required":["dynamic_schema_version","analysis_id","started_at","finished_at","status","mode","static_result","configuration","images","stages","runtime_events","baseline","final_snapshot","coverage","observer_health","isolation","errors","cleanup","limitations","diagnostics"],
  "properties":{
    "dynamic_schema_version":{"const":"1.0.0"},
    "analysis_id":{"type":"string","format":"uuid"},
    "started_at":{"type":"string","format":"date-time"},
    "finished_at":{"type":"string","format":"date-time"},
    "status":{"enum":["completed","rejected","failed"]},
    "mode":{"enum":["plugin","clean_control"]},
    "static_result":{"type":"object"},
    "configuration":{"type":"object"},
    "images":{"type":"object"},
    "stages":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["stage","started_at","finished_at","status","detail"],"properties":{"stage":{"type":"string"},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"status":{"enum":["completed","failed"]},"detail":{"type":"string"}}}},
    "runtime_events":{"type":"array","items":{"type":"object"}},
    "baseline":{"type":["object","null"]},
    "final_snapshot":{"type":["object","null"]},
    "coverage":{"type":"object","additionalProperties":false,"required":["file","database","account","cron","network"],"properties":{"file":{"type":"boolean"},"database":{"type":"boolean"},"account":{"type":"boolean"},"cron":{"type":"boolean"},"network":{"type":"boolean"}}},
    "observer_health":{"type":"object"},
    "isolation":{"type":"object"},
    "diagnostics":{"type":"object","additionalProperties":{"type":"string"}},
    "errors":{"type":"array","items":{"type":"object","required":["stage","code","message"],"additionalProperties":false,"properties":{"stage":{"type":"string"},"code":{"type":"string"},"message":{"type":"string"}}}},
    "cleanup":{"type":"object","additionalProperties":false,"required":["verified","resources","remaining"],"properties":{"verified":{"type":"boolean"},"resources":{"type":"array","items":{"type":"string"}},"remaining":{"type":"array","items":{"type":"string"}}}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string"}}
  },
  "allOf":[{"if":{"properties":{"status":{"const":"completed"}}},"then":{"properties":{"errors":{"maxItems":0},"cleanup":{"properties":{"verified":{"const":true},"remaining":{"maxItems":0}}}}},"else":{"properties":{"errors":{"minItems":1}}}}]
}
