# Environment & secrets
.env
.env.*
*.env
*.env.local
*.env.production
*.env.staging
*.env.development
# Keep example templates committable
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Credential / key material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.secret
secrets/
**/secrets/
credentials.json
**/credentials.json
service-account*.json
**/service-account*.json

# WordPress / local lab dumps that may contain secrets
**/wp-config.php
**/wp-config-*.php
*.sql
*.sql.gz
*.dump
aws.txt
**/aws.txt
**/terraform/*.tfstate
**/terraform/*.tfstate.*
**/terraform/.terraform/

# VETO: decoy twin is local-only for now (commit original site only)
veto-lab/decoy/

# Runtime / cache uploads
**/wp-content/uploads/**
!**/wp-content/uploads/index.php
**/wp-content/cache/
**/wp-content/upgrade/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Dependencies & build
node_modules/
vendor/
dist/
build/
*.log
npm-debug.log*
