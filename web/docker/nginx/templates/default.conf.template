# Local / plain-HTTP profile. ${DOMAIN} and ${CLIENT_MAX_BODY_SIZE} are filled
# in by the nginx image entrypoint (envsubst) at container start.

fastcgi_cache_path /var/cache/nginx/fastcgi levels=1:2 keys_zone=WORDPRESS:32m
                   max_size=512m inactive=20m use_temp_path=off;
fastcgi_cache_key "$scheme$request_method$host$request_uri";
# Ignore WP no-cache headers so anonymous HTML can be cached; keep Set-Cookie
# respected so session-bearing responses are never stored.
fastcgi_ignore_headers Cache-Control Expires;

limit_req_zone $binary_remote_addr zone=wplogin:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=wpadmin:10m rate=10r/s;

map $request_method $wp_skip_cache_method {
    default 1;
    GET     0;
    HEAD    0;
}

map $http_cookie $wp_skip_cache_cookie {
    default 0;
    ~*wordpress_logged_in_      1;
    ~*woocommerce_cart_hash     1;
    ~*woocommerce_items_in_cart 1;
    ~*comment_author_           1;
}

map $request_uri $wp_skip_cache_uri {
    default 0;
    ~*(?:/cart|/checkout|/my-account|/wc-api|/wp-admin|/wp-login\.php|/wp-json|/xmlrpc\.php) 1;
    ~*(?:\?|&)(?:add-to-cart|removed_item|logout|preview|elementor-preview)= 1;
}

map "$wp_skip_cache_method$wp_skip_cache_cookie$wp_skip_cache_uri" $wp_skip_cache {
    default 1;
    "000"   0;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml+rss
        application/rss+xml
        application/xhtml+xml
        image/svg+xml
        font/woff2
        font/ttf
        application/font-woff
        application/font-woff2;

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log warn;

    include /etc/nginx/snippets/wordpress.conf;
}
