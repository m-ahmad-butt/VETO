# Production profile: HTTP is only kept alive for the ACME challenge, everything
# else is redirected to HTTPS. Certificates come from the certbot service.

fastcgi_cache_path /var/cache/nginx/fastcgi levels=1:2 keys_zone=WORDPRESS:32m
                   max_size=512m inactive=20m use_temp_path=off;
fastcgi_cache_key "$scheme$request_method$host$request_uri";
# Ignore WP no-cache headers so anonymous HTML can be cached; keep Set-Cookie
# respected so session-bearing responses are never stored.
fastcgi_ignore_headers Cache-Control Expires;

limit_req_zone $binary_remote_addr zone=wplogin:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=wpadmin:10m rate=10r/s;

map $request_method $wp_skip_cache_method {
    default 1;
    GET     0;
    HEAD    0;
}

map $http_cookie $wp_skip_cache_cookie {
    default 0;
    ~*wordpress_logged_in_      1;
    ~*woocommerce_cart_hash     1;
    ~*woocommerce_items_in_cart 1;
    ~*comment_author_           1;
}

map $request_uri $wp_skip_cache_uri {
    default 0;
    ~*(?:/cart|/checkout|/my-account|/wc-api|/wp-admin|/wp-login\.php|/wp-json|/xmlrpc\.php) 1;
    ~*(?:\?|&)(?:add-to-cart|removed_item|logout|preview|elementor-preview)= 1;
}

map "$wp_skip_cache_method$wp_skip_cache_cookie$wp_skip_cache_uri" $wp_skip_cache {
    default 1;
    "000"   0;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # No ssl_stapling: Let's Encrypt dropped OCSP URLs from certificates in May
    # 2025 and shut down its responders in August 2025, so stapling would only
    # produce warnings. Revocation is published via CRLs instead.

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml+rss
        application/rss+xml
        application/xhtml+xml
        image/svg+xml
        font/woff2
        font/ttf
        application/font-woff
        application/font-woff2;

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log warn;

    # Keep the canonical host in one place: www always folds into the apex.
    if ($host = www.${DOMAIN}) {
        return 301 https://${DOMAIN}$request_uri;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    include /etc/nginx/snippets/wordpress.conf;
}
